# Copy to .env for local runs. .env is git-ignored and unreadable by Claude Code (see .claude/settings.json).
TE_DATABASE_URL=postgresql+asyncpg://te:te@localhost:5432/transcribe
TE_S3_ENDPOINT=http://localhost:9000
TE_S3_ACCESS_KEY=te-local
TE_S3_SECRET_KEY=te-local-secret
TE_S3_BUCKET=transcribe
TE_ASR_URL=http://localhost:8000
TE_MAX_FILE_SECONDS=10800
TE_MAX_FILE_BYTES=4294967296
TE_MAX_ATTEMPTS=3
TE_AUDIO_RETENTION_DAYS=30
