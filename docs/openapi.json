{
  "components": {
    "schemas": {
      "CorrectionIn": {
        "properties": {
          "base_version": {
            "minimum": 1.0,
            "title": "Base Version",
            "type": "integer"
          },
          "edits": {
            "items": {
              "$ref": "#/components/schemas/EditIn"
            },
            "maxItems": 500,
            "title": "Edits",
            "type": "array"
          },
          "speaker_renames": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 64,
            "title": "Speaker Renames",
            "type": "object"
          }
        },
        "required": [
          "base_version"
        ],
        "title": "CorrectionIn",
        "type": "object"
      },
      "CreateTranscriptionIn": {
        "properties": {
          "diarization": {
            "default": false,
            "title": "Diarization",
            "type": "boolean"
          },
          "engine": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "speakers": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speakers"
          },
          "upload_id": {
            "pattern": "^[0-9a-f]{32}$",
            "title": "Upload Id",
            "type": "string"
          },
          "webhook_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhook Url"
          }
        },
        "required": [
          "upload_id",
          "language"
        ],
        "title": "CreateTranscriptionIn",
        "type": "object"
      },
      "DeletionOut": {
        "properties": {
          "deletion_requested_at": {
            "format": "date-time",
            "title": "Deletion Requested At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "deletion_requested_at"
        ],
        "title": "DeletionOut",
        "type": "object"
      },
      "EditIn": {
        "properties": {
          "new_text": {
            "maxLength": 2000,
            "title": "New Text",
            "type": "string"
          },
          "segment_id": {
            "maxLength": 64,
            "title": "Segment Id",
            "type": "string"
          },
          "word_index_from": {
            "minimum": 0.0,
            "title": "Word Index From",
            "type": "integer"
          },
          "word_index_to": {
            "minimum": 0.0,
            "title": "Word Index To",
            "type": "integer"
          }
        },
        "required": [
          "segment_id",
          "word_index_from",
          "word_index_to",
          "new_text"
        ],
        "title": "EditIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IndexOut": {
        "properties": {
          "chunks": {
            "title": "Chunks",
            "type": "integer"
          },
          "embedded": {
            "title": "Embedded",
            "type": "integer"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "reused": {
            "title": "Reused",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "job_id",
          "version",
          "chunks",
          "embedded",
          "reused"
        ],
        "title": "IndexOut",
        "type": "object"
      },
      "JobOut": {
        "properties": {
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "progress": {
            "title": "Progress",
            "type": "integer"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "id",
          "state",
          "stage",
          "progress",
          "warnings",
          "error_code"
        ],
        "title": "JobOut",
        "type": "object"
      },
      "RagChunkOut": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "end_ms": {
            "title": "End Ms",
            "type": "integer"
          },
          "start_ms": {
            "title": "Start Ms",
            "type": "integer"
          }
        },
        "required": [
          "chunk_id",
          "start_ms",
          "end_ms",
          "body"
        ],
        "title": "RagChunkOut",
        "type": "object"
      },
      "RagChunksOut": {
        "properties": {
          "chunks": {
            "items": {
              "$ref": "#/components/schemas/RagChunkOut"
            },
            "title": "Chunks",
            "type": "array"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "chunks"
        ],
        "title": "RagChunksOut",
        "type": "object"
      },
      "SearchHitOut": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "deeplink": {
            "title": "Deeplink",
            "type": "string"
          },
          "end_ms": {
            "title": "End Ms",
            "type": "integer"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "media_id": {
            "title": "Media Id",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "start_ms": {
            "title": "Start Ms",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "chunk_id",
          "job_id",
          "version",
          "media_id",
          "start_ms",
          "end_ms",
          "body",
          "score",
          "deeplink"
        ],
        "title": "SearchHitOut",
        "type": "object"
      },
      "SearchOut": {
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/components/schemas/SearchHitOut"
            },
            "title": "Hits",
            "type": "array"
          }
        },
        "required": [
          "hits"
        ],
        "title": "SearchOut",
        "type": "object"
      },
      "UploadTicketOut": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Fields",
            "type": "object"
          },
          "max_bytes": {
            "title": "Max Bytes",
            "type": "integer"
          },
          "upload_id": {
            "title": "Upload Id",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "upload_id",
          "url",
          "fields",
          "expires_at",
          "max_bytes"
        ],
        "title": "UploadTicketOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionOut": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "job_id",
          "version"
        ],
        "title": "VersionOut",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Transcribe Engine",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/search": {
      "get": {
        "operationId": "search_v1_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 500,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search"
      }
    },
    "/v1/transcriptions": {
      "post": {
        "operationId": "create_transcription_v1_transcriptions_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTranscriptionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Transcription"
      }
    },
    "/v1/transcriptions/{job_id}": {
      "delete": {
        "operationId": "request_transcription_deletion_v1_transcriptions__job_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request Transcription Deletion"
      },
      "get": {
        "operationId": "get_transcription_v1_transcriptions__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Transcription"
      }
    },
    "/v1/transcriptions/{job_id}/rag-chunks": {
      "get": {
        "operationId": "list_rag_chunks_v1_transcriptions__job_id__rag_chunks_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RagChunksOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Rag Chunks"
      }
    },
    "/v1/transcriptions/{job_id}/result": {
      "get": {
        "description": "json is the word-level body of S10; canonical, txt, md, csv, srt and vtt render from the\ncanonical transcript (S15).",
        "operationId": "get_transcription_result_v1_transcriptions__job_id__result_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "json",
              "title": "Format",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Transcription Result"
      }
    },
    "/v1/transcriptions/{job_id}/subtitles": {
      "get": {
        "operationId": "get_subtitles_v1_transcriptions__job_id__subtitles_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "srt",
              "title": "Format",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "profile",
            "required": false,
            "schema": {
              "default": "broadcast",
              "title": "Profile",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "numerals",
            "required": false,
            "schema": {
              "default": "western",
              "enum": [
                "western",
                "arabic_indic"
              ],
              "title": "Numerals",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Subtitles"
      }
    },
    "/v1/transcriptions/{job_id}/versions": {
      "post": {
        "operationId": "save_transcript_version_v1_transcriptions__job_id__versions_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorrectionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Transcript Version"
      }
    },
    "/v1/transcriptions/{job_id}:cancel": {
      "post": {
        "operationId": "cancel_transcription_v1_transcriptions__job_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Cancel Transcription"
      }
    },
    "/v1/transcriptions/{job_id}:index": {
      "post": {
        "operationId": "index_transcription_v1_transcriptions__job_id__index_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Index Transcription"
      }
    },
    "/v1/uploads": {
      "post": {
        "operationId": "create_upload_v1_uploads_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadTicketOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Upload"
      }
    }
  }
}
