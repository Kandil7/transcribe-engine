{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcribe-engine.local/schemas/transcript-1.0.json",
  "title": "Canonical transcript 1.0",
  "description": "The versioned source every output renders from (ADR-0004). Times are integer milliseconds (ADR-0003). raw_text, search_text and word offsets are derived and not stored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transcript_id", "version", "source", "media", "provenance",
    "speakers", "segments", "events", "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "transcript_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "source": { "enum": ["asr", "human"] },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_id", "duration_ms", "language"],
      "properties": {
        "media_id": { "type": "string", "minLength": 1 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "language": { "type": "string", "minLength": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "revision", "pipeline_version", "config_hash"],
      "properties": {
        "engine": { "type": "string" },
        "revision": { "type": "string" },
        "pipeline_version": { "type": "string" },
        "config_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_ms", "end_ms", "speaker", "words"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 },
          "speaker": { "type": ["string", "null"] },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "start_ms", "end_ms", "lang", "conf"],
              "properties": {
                "text": { "type": "string" },
                "start_ms": { "type": "integer", "minimum": 0 },
                "end_ms": { "type": "integer", "minimum": 0 },
                "lang": { "type": "string", "minLength": 1 },
                "conf": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "start_ms", "end_ms"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
